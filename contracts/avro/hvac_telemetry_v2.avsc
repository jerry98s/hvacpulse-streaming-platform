{
  "type": "record",
  "name": "HvacTelemetry",
  "namespace": "com.hvacpulse.contracts",
  "doc": "HVAC equipment telemetry envelope, firmware schema v2. Additive change vs v1: optional co2_ppm.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "Physical event identity, generated by the device gateway."},
    {"name": "logical_event_id", "type": "string", "doc": "Stable logical identity shared by all revisions of a reading."},
    {"name": "revision_number", "type": "int", "default": 1},
    {"name": "supersedes_event_id", "type": ["null", "string"], "default": null},
    {"name": "schema_id", "type": "int"},
    {"name": "schema_version", "type": "int"},
    {"name": "firmware_version", "type": "string"},
    {"name": "event_time", "type": "string", "doc": "ISO-8601 UTC timestamp of the equipment snapshot."},
    {"name": "gateway_id", "type": "string"},
    {"name": "device_id", "type": "string"},
    {"name": "boot_id", "type": "string"},
    {"name": "sequence_number", "type": "long"},
    {"name": "site_id", "type": "string"},
    {"name": "zone_id", "type": "string"},
    {
      "name": "measurements",
      "type": {
        "type": "record",
        "name": "Measurements",
        "fields": [
          {"name": "supply_air_temp_c", "type": ["null", "double"], "default": null},
          {"name": "return_air_temp_c", "type": ["null", "double"], "default": null},
          {"name": "zone_temp_c", "type": ["null", "double"], "default": null},
          {"name": "relative_humidity_pct", "type": ["null", "double"], "default": null},
          {"name": "airflow_m3h", "type": ["null", "double"], "default": null},
          {"name": "static_pressure_pa", "type": ["null", "double"], "default": null},
          {"name": "fan_speed_pct", "type": ["null", "double"], "default": null},
          {"name": "chilled_water_valve_pct", "type": ["null", "double"], "default": null},
          {"name": "power_kw", "type": ["null", "double"], "default": null},
          {"name": "co2_ppm", "type": ["null", "double"], "default": null, "doc": "Added in firmware v2. Nullable with null default for BACKWARD compatibility."}
        ]
      }
    },
    {
      "name": "operating_state",
      "type": {
        "type": "record",
        "name": "OperatingState",
        "fields": [
          {"name": "mode", "type": "string"},
          {"name": "temperature_setpoint_c", "type": ["null", "double"], "default": null},
          {"name": "equipment_running", "type": "boolean"}
        ]
      }
    }
  ]
}
